    "mode": "full_if_both_limits_allow_else_sampled_cross_product",
    "sample_rows": 128,
    "sample_columns": 128,
    "sampling": "seeded without replacement, always including first and last row/column; record indices; reference uses all K",
    "gate": {
      "require_finite": true,
      "relative_l2_max": 0.02,
      "max_abs_atol": 0.001,
      "max_abs_reference_rtol": 0.05
    },
    "gate_expression": "finite && relative_l2 <= 0.02 && max_abs_error <= 0.001 + 0.05 * max_abs_reference",
    "metrics": [
      "reference_scope",
      "sample_count",
      "relative_l2",
      "max_abs_error",
      "max_abs_reference",
      "rmse",
      "mean_abs_error",
      "p50_abs_error",
      "p99_abs_error",
      "normwise_error",
      "finite",
      "pass"
    ],
    "near_zero_denominator": 1e-30,
    "failure_policy": "Record failures and measurements; failing rows cannot count as valid speedup wins. Fixed thresholds never change to rescue an arm.",
    "scope": "Finite synthetic numerical eligibility only; no bound on model quality or worst-case error."
  },
