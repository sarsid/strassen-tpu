  "correctness": {
    "failure_policy": "Record failures and measurements; failing rows cannot count as valid speedup wins. Fixed thresholds never change to rescue an arm.",
    "gate": {
      "max_abs_atol": 0.001,
      "max_abs_reference_rtol": 0.05,
      "relative_l2_max": 0.02,
      "require_finite": true
    },
    "gate_expression": "finite && relative_l2 <= 0.02 && max_abs_error <= 0.001 + 0.05 * max_abs_reference",
    "input_reference": "Use the exact BF16-quantized operands cast to NumPy float32, not the pre-quantization random source.",
    "metrics": [
      "reference_scope",
      "sample_count",
      "relative_l2",
      "max_abs_error",
      "max_abs_reference",
      "rmse",
      "mean_abs_error",
      "p50_abs_error",
      "p99_abs_error",
      "normwise_error",
      "finite",
      "pass"
    ],
    "mode": "full_if_both_limits_allow_else_sampled_cross_product",
    "near_zero_denominator": 1e-30,
    "reference": "host_numpy_fp32",
    "sample_columns": 128,
    "sample_rows": 128,
    "sampling": "seeded without replacement, always including first and last row/column; record indices; reference uses all K",
    "scope": "Finite synthetic numerical eligibility only; no bound on model quality or worst-case error."
  },
  "deferred": [
    "Two-level Strassen remains optional future work, excluded.",
    "v6e replication only after all v5e N5-N9 stages and separately labeled fresh-v5e replication.",
    "Do not infer model quality from N4 or from the shape selector."
  ],
  "device": {
    "allow_concurrent_timing": false,
    "allow_v6e": false,
    "cohort_note": "The N1-N4 allocation was lost. N5-N9 use one new v5e allocation; compare arms only within this new cohort. Do not pool old timings.",
    "identity_fields": [
      "allocation_id",
      "device_kind",
      "device_id",
      "process_index",
      "jax_version",
      "jaxlib_version",
      "libtpu_version",
      "runtime_image",
      "runtime_flags",
      "host_id"
    ],
    "identity_missing_policy": "Record unknown explicitly; do not describe unverified physical identity as the same chip.",
    "require_identity_match": true,
    "reuse_same_allocation": true,
    "single_device": true,
    "target": "v5e"
  },
  "distribution_manifest": "distributions_v1.json",
  "execution_contract": {
    "archive_after_run": [
      "summary.json",
      "status snapshot",
      "artifact SHA256 manifest",
      "completion/failure marker"
    ],
    "archive_before_run": [
      "source tree snapshot",
      "configuration JSON",
      "source/configuration SHA256 manifests",
      "git commit",
      "environment fingerprint",
      "planned cases"
    ],
    "archive_during_run": [
      "append-only events.jsonl",
      "stdout/stderr",
      "raw timing samples",
      "errors"
    ],
    "commit_policy": "Root orchestrator commits source snapshot before execution and records a commit after every completed or failed execution. Existing source snapshots and result directories are never overwritten.",
    "external_changes": "Any device or environment change creates a new cohort; do not pool it silently with the original allocation.",
    "immutable_run_id": "UTC timestamp plus unique suffix",
    "record_statuses": [
      "ok",
      "input_error",
      "numerical_failure",
      "compile_error",
      "oom",
      "unsupported",
      "skipped_memory_preflight",
      "interrupted",
      "not_run"
    ],
    "resume": "A retry/new version receives a new run id and references previous run ids; never appends measurements to a sealed run."
  },
