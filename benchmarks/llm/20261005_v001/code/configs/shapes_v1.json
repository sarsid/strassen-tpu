  "input_semantics": "All active entries use synthetic inputs with fixed seeds. LLM-shaped means geometry only, never checkpoint weights or model-quality validation.",
  "projection_derivations": {
    "gate_up": "K=hidden_size; N=2*intermediate_size (concatenated weights; no activation)",
    "q": "K=hidden_size; N=num_attention_heads*head_dim",
    "kv": "K=hidden_size; N=num_key_value_heads*head_dim (one key OR value projection, not concatenated K+V)",
    "o": "K=num_attention_heads*head_dim; N=hidden_size",
    "down": "K=intermediate_size; N=hidden_size",
    "m": "Chosen token-row count, not model context-length claim; no attention/activation computation."
  },
