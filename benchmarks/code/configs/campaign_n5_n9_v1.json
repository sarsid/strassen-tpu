    "max_full_reference_flops": 2000000000,
    "execution_order": "smoke first; remaining shapes in ascending estimated live bytes, largest anchor last",
    "preflight": "Estimate and record bytes for original inputs, padded inputs, FP32 output, one result, and reference samples. Conservative estimate is not measured peak memory.",
    "on_preflight_over_budget": "Record skipped_memory_preflight with estimate and limit; do not silently remove shape.",
    "on_device_oom": "Record oom, clear executable/input buffers before the next case; retry only in a new immutable run."
  },
  "correctness": {
    "input_reference": "Use the exact BF16-quantized operands cast to NumPy float32, not the pre-quantization random source.",
